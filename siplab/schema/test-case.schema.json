{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://siplab.local/schema/test-case.schema.json",
  "title": "SIPLab Test Case",
  "description": "A labeled test description, written in YAML as <test-id>.test.yaml (or test-case.yaml in scenario folders). This is the AI input. The ground truth lives in a separate truth file (truth.schema.json) that is never pasted into the chat.",
  "type": "object",
  "required": [
    "test_id",
    "title",
    "objective",
    "focus",
    "endpoints",
    "preconditions",
    "steps",
    "expected_observations",
    "observed_by_tester",
    "capture"
  ],
  "additionalProperties": false,
  "properties": {
    "test_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "focus": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "description": "What the test exercises. The orchestrator selects one skill per focus tag (routing table); nothing else selects skills.",
      "items": {
        "type": "string",
        "enum": [
          "registration",
          "call",
          "media_negotiation",
          "messaging",
          "nat",
          "transactions",
          "security",
          "interworking",
          "ims",
          "media_quality"
        ]
      }
    },
    "endpoints": {
      "type": "array",
      "minItems": 1,
      "description": "SIP users and devices involved, with lab addresses.",
      "items": {
        "type": "object",
        "required": [
          "user",
          "device",
          "address",
          "role"
        ],
        "additionalProperties": false,
        "properties": {
          "user": {
            "type": "string",
            "description": "SIP user / extension, e.g. '1001'."
          },
          "device": {
            "type": "string",
            "description": "e.g. 'Linphone desktop', 'Linphone Android'."
          },
          "address": {
            "type": "string",
            "description": "Lab IP address."
          },
          "role": {
            "type": "string",
            "enum": [
              "caller",
              "callee",
              "registrant",
              "sender",
              "recipient",
              "pbx",
              "other"
            ]
          }
        }
      }
    },
    "pbx": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "software": {
          "type": "string"
        },
        "address": {
          "type": "string"
        },
        "notes": {
          "type": "string",
          "description": "Configuration facts the skills need, e.g. 'unregistered endpoints are answered with 404 (default dial plan)'."
        }
      }
    },
    "preconditions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "expected_observations": {
      "type": "array",
      "minItems": 1,
      "description": "Protocol-level expectations, e.g. 'An INVITE reaches the called user'. Not a verdict.",
      "items": {
        "type": "string"
      }
    },
    "observed_by_tester": {
      "type": "array",
      "description": "What the tester saw or heard, e.g. 'Both users heard audio'. Signaling evidence cannot confirm audio; this field can.",
      "items": {
        "type": "string"
      }
    },
    "capture": {
      "type": "object",
      "required": [
        "file",
        "transport",
        "recipe"
      ],
      "additionalProperties": false,
      "properties": {
        "file": {
          "type": "string"
        },
        "transport": {
          "type": "string",
          "enum": [
            "udp",
            "tcp",
            "tls",
            "mixed"
          ]
        },
        "recipe": {
          "type": "string",
          "description": "Extraction recipe used, e.g. 'reference' or 'reference+messaging'."
        },
        "synthetic": {
          "type": "boolean",
          "description": "true when the evidence table was hand-built rather than extracted from a real capture."
        }
      }
    }
  }
}
